{
  "name": "systo",
  "version": "0.1.11",
  "private": true,
  "scripts": {
    "dev": "farm dev --desktop",
    "dev:web": "farm dev",
    "build": "farm build --desktop",
    "build:web": "farm build",
    "icons": "node scripts/gen-icons.mjs",
    "type-check": "tsc --noEmit",
    "build:linux-packages": "node scripts/build-linux-packages.mjs",
    "build:installer": "pnpm icons && pnpm build && node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@farm.js/core": "0.1.67",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@farm.js/cli": "0.1.67",
    "@farm.js/desktop": "0.1.0-beta.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electrobun": "^2.0.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "productName": "Systo",
  "description": "A simple, monochrome process manager for macOS, Windows and Linux with a Dynamic Island.",
  "electrobun": {
    "runtime": {
      "exitOnLastWindowClosed": false
    },
    "release": {
      "baseUrl": "https://github.com/MohammedIbrahim8887/systo/releases/latest/download",
      "generatePatch": false
    }
  }
}
